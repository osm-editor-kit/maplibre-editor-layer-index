{
  "name": "maplibre-editor-layer-index-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @osm-editor-kit/maplibre-editor-layer-index build",
    "eli:build": "bun run --filter @osm-editor-kit/maplibre-editor-layer-index eli:build",
    "test-run": "bun run --filter @osm-editor-kit/maplibre-editor-layer-index test-run",
    "type-check": "bun run --filter '*' type-check",
    "lint": "oxlint --fix -c oxlint.config.mjs .",
    "lint-check": "oxlint -c oxlint.config.mjs .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format-check": "oxfmt -c oxfmt.config.mjs --check .",
    "prepare": "husky",
    "check-exports": "bun run --filter @osm-editor-kit/maplibre-editor-layer-index check-exports",
    "check": "bun run lint-check && bun run format-check && bun run build && bun run type-check && bun run --filter @osm-editor-kit/maplibre-editor-layer-index check-size && bun run test-run && bun run check-exports",
    "dev": "bun run --filter preview dev",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.4.4"
}
